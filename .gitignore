# libraries are fetched, not shipped (see ATTRIBUTION.md)
/data/ldraw/
/data/shadow/
/data/*.json
/data/*.bin

# build
/bin/
# the built binary at the repo root; anchored so it does not swallow cmd/brickmesh/
/brickmesh

# python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Built by "make web" from the Go sources, and a symlink to examples/.
/web/brickmesh.wasm
/web/examples

# Generated by "make assets" from the parts libraries: large, and derived data
# rather than source. See docs/architecture.md.
/web/data/

# Downloaded wheels and archives. One of these got swept into a commit by an
# over-eager "git add -A"; the dependency belongs in pyproject.toml, not here.
*.whl
*.zip
